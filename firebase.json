{
  "hosting": [
    {
      "site": "bocadit",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "scratch/**"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**/products.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(js|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/menu",
          "destination": "/menu.html"
        }
      ]
    },
    {
      "site": "bocadit-d5a7c",
      "redirects": [
        {
          "source": "/**",
          "destination": "https://bocadit.web.app",
          "type": 301
        }
      ]
    }
  ]
}
